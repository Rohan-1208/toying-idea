{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?action=login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth?action=me"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/inquiries/:id",
      "destination": "/api/inquiries?id=:id"
    },
    {
      "source": "/api/uploads/:id",
      "destination": "/api/health?resource=uploads"
    },
    {
      "source": "/api/studio/print-jobs/:id",
      "destination": "/api/studio?resource=print-jobs&id=:id"
    },
    {
      "source": "/api/studio/drafts/:id",
      "destination": "/api/studio?resource=drafts&id=:id"
    },
    {
      "source": "/api/studio/:resource",
      "destination": "/api/studio?resource=:resource"
    },
    {
      "source": "/api/admin/agent-os",
      "destination": "/api/agent-os"
    },
    {
      "source": "/api/admin/agent-os/:a",
      "destination": "/api/agent-os?a=:a"
    },
    {
      "source": "/api/admin/agent-os/:a/:b",
      "destination": "/api/agent-os?a=:a&b=:b"
    },
    {
      "source": "/api/admin/agent-os/:a/:b/:c",
      "destination": "/api/agent-os?a=:a&b=:b&c=:c"
    },
    {
      "source": "/((?!api/|src/|@|node_modules/|assets/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
