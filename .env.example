# =============================================================================
# Supabase — catalog, orders, inquiries, drafts, print jobs (replaces Mongo + Shopify)
# =============================================================================
# 1. Create a project at https://supabase.com
# 2. SQL editor: paste supabase/schema.sql (creates tables, storage bucket, seed products)
# 3. Settings → API: copy URL + service_role key into Vercel env, then redeploy

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Optional public alias if you also want the Vite app to know the project URL
# VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

JWT_SECRET="generate-a-long-random-string-here"
ADMIN_EMAIL="admin@toyingidea.com"
ADMIN_PASSWORD="change-me"
# ADMIN_PASSWORD_HASH="$2a$10$..."   # npm run hash:admin -- "your-password"

VITE_API_BASE=""
PUBLIC_SITE_URL="https://toying-idea.vercel.app"

# Optional — catalog/marketing/inbox copy + extra product stills
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Optional — order emails via Resend
# RESEND_API_KEY=""
